#pragma once
#include <string>
#include <string_view>
#include <span>
#include <utility> // Required for std::to_underlying (C++23)
#include "raylib.h"

namespace RaylibStd {

{% for em in ems %}
    /**
    * @brief {{ em.description }}
    */
    enum class {{ em.name }} : int {
        {%- set em_values = em.get('values', []) -%}
        {%- for value in em_values %}
        {{ value.name }} = {{ value.value }}, // {{ value.description }}
        {%- endfor %}
    };
{% endfor %}

{% for func in functions %}
    /**
     * @brief {{ func.description }}
     */
    {% if func.has_varargs %} template <typename... Args> {% endif %}
    {%- if func.is_nodiscard %}[[nodiscard]] {% endif -%}
    inline {{ func.returnType }} {{ func.name }}({{ func.mapped_params }}) {
        {%- if func.returns_string %}
        const char* _ret = ::{{ func.original_name }}({{ func.call_args }});
        return _ret ? std::string(_ret) : std::string();
        {%- elif func.returnType != "void" %}
        return {% if func.returns_enum %}static_cast<{{ func.returnType }}>({% endif %}::{{ func.original_name }}({{ func.call_args }}){% if func.returns_enum %}){% endif %};
        {%- else %}
        ::{{ func.original_name }}({{ func.call_args }});
        {%- endif %}
    }
{% endfor %}

} // namespace RaylibStd