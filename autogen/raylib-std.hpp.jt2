#pragma once
#include <string_view>
#include <span>
#include "raylib.h"

namespace RaylibStd {

{% for em in ems %}
    /**
    * @brief {{ em.description }}
    */
    enum class {{ em.name }} : int {
        {%- set em_values = em.get('values', []) -%}
        {%- for value in em_values %}
        {{ value.name }} = {{ value.value }}, // {{ value.description }}
        {%- endfor %}
    };
{% endfor %}

{% for func in functions %}
    /**
     * @brief {{ func.description }}
     */
    {% if func.has_varargs %}
    template <typename... Args>
    {%- endif %}
    {%- if func.is_nodiscard %}[[nodiscard]] {% endif -%}
    inline {{ func.returnType }} {{ func.name }}({{ func.mapped_params }}) {
        {% if func.returnType != "void" %}return {% endif -%}

        {%- if func.returns_enum %}static_cast<{{ func.returnType }}>(
        {%- endif -%}

        ::{{ func.name }}({{ func.call_args }})

        {%- if func.returns_enum %}){% endif -%};
    }
{% endfor %}

} // namespace RaylibStd